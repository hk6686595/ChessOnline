<UserControl x:Class="XiangqiClient.Controls.EmojiPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="EmojiBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#32426f"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="OpenBtn" Style="{StaticResource SmallBtn}" Width="42"
                Padding="0,3" Click="OpenBtn_Click" ToolTip="插入表情" Cursor="">
            <Image Source="pack://application:,,,/assets/emoji/1f600.png" Width="18" Height="18"/>
        </Button>
        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=OpenBtn}" Placement="Top"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="None">
            <Border Background="#1b2438" BorderBrush="#3a4a78" BorderThickness="1" CornerRadius="8"
                    Padding="8" Margin="0,0,0,6" MaxWidth="268">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                </Border.Effect>
                <WrapPanel x:Name="Panel"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
