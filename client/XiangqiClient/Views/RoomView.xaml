<UserControl x:Class="XiangqiClient.Views.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:XiangqiClient.Controls">
    <Grid Background="#141a28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#1b2438" Padding="12,8" BorderBrush="#2a3550" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="{Binding RoomTitle}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ConnectText}" Foreground="#37d67a" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="离开房间" Style="{StaticResource SmallBtn}" Command="{Binding LeaveRoomCmd}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 三栏布局：左侧信息/操作 | 中间棋盘（居中）| 右侧棋谱/聊天 -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：玩家 / 回合 / 结果 / 状态 / 设置 / 操作 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 玩家 + 倒计时（倒计时独占一行，避免长昵称挤压显示不全） -->
                <Border Grid.Row="0" Background="#1b2438" Padding="12" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding PlayersInfo}" Foreground="#e6ecf5" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <Border Background="#202a44" CornerRadius="6" Padding="10,4"
                                HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TurnTimerText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TurnTimerText}" Foreground="#ffd54a" FontSize="14" FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Room.Players}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" Foreground="#8b98b5">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding IsOwner, Converter={StaticResource OwnerConverter}}"
                                                   Foreground="#ffd54a" FontSize="12"/>
                                        <TextBlock Text="{Binding Ready, Converter={StaticResource ReadyConverter}}"
                                                   Foreground="#37d67a" FontSize="12" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#202a44" Padding="12" CornerRadius="8" Margin="0,8,0,0">
                    <TextBlock Text="{Binding TurnText}" Foreground="#e6ecf5" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                </Border>

                <Border Grid.Row="2" Background="#202a44" Padding="12" CornerRadius="8" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ResultText}" Foreground="#ffd54a" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                </Border>

                <Border Grid.Row="3" Background="#202a44" Padding="12" CornerRadius="8" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="#8b98b5" TextWrapping="Wrap"/>
                </Border>

                <!-- 对局设置：等待中显示，仅房主可修改 -->
                <Border Grid.Row="4" Background="#1b2438" Padding="12" CornerRadius="8" Margin="0,8,0,0"
                        Visibility="{Binding ShowGameConfig, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel IsEnabled="{Binding CanConfigureGame}">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="⚙ 对局设置" FontWeight="Bold" Foreground="#e6ecf5"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GameConfigText}" Foreground="#8b98b5"
                                       FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="每步时限" Foreground="#8b98b5" FontSize="12"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsPvp, Converter={StaticResource BoolToVisConverter}}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Combo}"
                                       ItemsSource="{Binding TimeLimitOptions}" SelectedItem="{Binding SelectedTimeLimit}"
                                       Visibility="{Binding IsPvp, Converter={StaticResource BoolToVisConverter}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="局时" Foreground="#8b98b5" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,6,0,0"
                                       Visibility="{Binding IsPvp, Converter={StaticResource BoolToVisConverter}}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,6,0,0"
                                      ItemsSource="{Binding GameTimeOptionLabels}" SelectedIndex="{Binding SelectedGameTimeIndex}"
                                      Visibility="{Binding IsPvp, Converter={StaticResource BoolToVisConverter}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="先后手" Foreground="#8b98b5" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,6,0,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,6,0,0"
                                      ItemsSource="{Binding FirstMoveOptions}" SelectedIndex="{Binding FirstMoveIndex}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 邀请好友（仅 pvp 房间内显示） -->
                <Border Grid.Row="5" Background="#1b2438" Padding="10,8" CornerRadius="8" Margin="0,8,0,0"
                        Visibility="{Binding CanInvite, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <TextBlock Text="📨 邀请好友对战" FontWeight="Bold" Foreground="#e6ecf5" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="邀请" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"
                                    Command="{Binding SendInviteCmd}"/>
                            <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Friends}"
                                      DisplayMemberPath="Name" SelectedItem="{Binding SelectedFriend, Mode=TwoWay}"
                                      ToolTip="选择要邀请的好友"/>
                        </DockPanel>
                        <TextBlock Text="仅可邀请已是好友的用户" Foreground="#8b98b5" FontSize="10" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 操作按钮（纵向排列） -->
                <StackPanel Grid.Row="6" Margin="0,10,0,0">
                    <Button Content="{Binding ReadyButtonText}" Style="{StaticResource Btn}" Margin="0,0,0,8"
                            Command="{Binding ReadyCmd}" HorizontalAlignment="Stretch"/>
                    <Button Content="开始对局" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,8"
                            Command="{Binding StartCmd}" HorizontalAlignment="Stretch"/>
                    <Button Content="悔棋" Style="{StaticResource Btn}" Margin="0,0,0,8"
                            Command="{Binding UndoCmd}" HorizontalAlignment="Stretch"/>
                    <!-- 走法提示仅象棋提供 -->
                    <Button Content="💡 提示" Margin="0,0,0,8" Command="{Binding HintCmd}"
                            HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGomoku}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="求和" Margin="0,0,0,8"
                            Command="{Binding DrawOfferCmd}" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPvp}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="认输" Style="{StaticResource DangerBtn}" Margin="0,0,0,8"
                            Command="{Binding SurrenderCmd}" HorizontalAlignment="Stretch"/>
                    <Button Content="再来一局" Style="{StaticResource Btn}"
                            Command="{Binding RestartCmd}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- 悔棋请求提示条 -->
                <Border Grid.Row="7" Background="#3a2f14" BorderBrush="#ffd54a" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UndoPromptVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding UndoPromptText}" Foreground="#ffd54a" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="同意" Style="{StaticResource SmallBtn}" Background="#1f7a44"
                                    Command="{Binding AgreeUndoCmd}" Margin="0,0,6,0"/>
                            <Button Content="拒绝" Style="{StaticResource SmallBtn}" Command="{Binding RejectUndoCmd}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 求和请求提示条 -->
                <Border Grid.Row="8" Background="#143a2f" BorderBrush="#37d67a" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DrawPromptVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding DrawPromptText}" Foreground="#37d67a" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="同意" Style="{StaticResource SmallBtn}" Background="#1f7a44"
                                    Command="{Binding AgreeDrawCmd}" Margin="0,0,6,0"/>
                            <Button Content="拒绝" Style="{StaticResource SmallBtn}" Command="{Binding RejectDrawCmd}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 中间：棋盘居中（随窗口等比缩放） -->
            <Viewbox Grid.Column="2" Stretch="Uniform" MaxWidth="720" MaxHeight="760"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#1b2438" Padding="12" CornerRadius="8">
                    <Grid>
                        <ctl:XiangqiBoard Game="{Binding Game}" SelectedFrom="{Binding SelectedFrom}"
                                          BlackPerspective="{Binding IsBlackView}" Hint="{Binding Hint}"
                                          CellClicked="Board_CellClicked">
                            <ctl:XiangqiBoard.Style>
                                <Style TargetType="ctl:XiangqiBoard">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGomoku}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:XiangqiBoard.Style>
                        </ctl:XiangqiBoard>
                        <ctl:GomokuBoard Game="{Binding Game}" CellClicked="Board_CellClicked"
                                         Visibility="{Binding IsGomoku, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>
                </Border>
            </Viewbox>

            <!-- 右侧：棋谱 + 房间聊天 -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="230"/>
                </Grid.RowDefinitions>

                <!-- 棋谱 -->
                <Border Grid.Row="0" Background="#1b2438" Padding="12" CornerRadius="8" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="📜 棋谱" FontWeight="Bold" Foreground="#e6ecf5" Margin="0,0,0,8"/>
                        <ListBox x:Name="MoveListBox" ItemsSource="{Binding MoveList}" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Foreground="#c8d3e8" FontSize="12" Margin="0,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 房间聊天：消息列表占满可滚动，底部输入框固定 -->
                <Border Grid.Row="1" Background="#1b2438" Padding="12" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="💬 房间聊天" FontWeight="Bold" Foreground="#e6ecf5" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1" x:Name="RoomChatList" ItemsSource="{Binding RoomChats}" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                 ItemTemplate="{StaticResource ChatBubbleTemplate}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <!-- 底部固定输入框 -->
                        <DockPanel Grid.Row="2">
                            <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource PrimaryBtn}" Width="64"
                                    Margin="8,0,0,0" Command="{Binding SendRoomChatCmd}"/>
                            <ctl:EmojiPicker DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                             EmojiPicked="RoomEmoji_Picked"/>
                            <TextBox Text="{Binding RoomChatInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ChatInputBox}" KeyDown="RoomChat_KeyDown"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
