<UserControl x:Class="XiangqiClient.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:XiangqiClient.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <!-- 游戏类型切换：明显的卡片式分段按钮 -->
        <Style x:Key="GameRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#1b2438" BorderBrush="#2a3550" BorderThickness="2"
                                CornerRadius="10" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="accent" Grid.Column="0" Width="4" Background="#4f8cff"
                                        CornerRadius="2" Margin="0,0,12,0" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22324f"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4f8cff"/>
                                <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3a4a6a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="#141a28">
        <!-- 主内容 -->
        <DockPanel>
            <!-- 顶栏 -->
            <Border DockPanel.Dock="Top" Background="#1b2438" Padding="12,8" BorderBrush="#2a3550" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="⚔️ 对战平台 · 象棋 / 五子棋" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding ConnectText}" Foreground="#37d67a" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="Avatar_Click" Cursor="Hand" ToolTip="点击更换头像"
                                Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#e8ecf4" BorderBrush="#c0c8d8" BorderThickness="1">
                                <TextBlock Text="{Binding UserAvatar}" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                        <TextBlock Text="{Binding UserBar}" Foreground="#e6ecf5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="退出登录" Click="Logout_Click" Style="{StaticResource SmallBtn}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 左：创建/匹配 + 房间列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1b2438" Padding="12" CornerRadius="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="🎮 选择游戏类型" FontSize="14" FontWeight="Bold" Foreground="#e6ecf5" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="LobbyGame" Style="{StaticResource GameRadioStyle}"
                                         IsChecked="{Binding IsXiangqiSelected}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="♟️" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="中国象棋" FontSize="15" FontWeight="Bold" Foreground="#e6ecf5"/>
                                        <TextBlock Text="车马炮 · 将帅对决" FontSize="11" Foreground="#8b98b5"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="2" GroupName="LobbyGame" Style="{StaticResource GameRadioStyle}"
                                         IsChecked="{Binding IsGomokuSelected}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚪" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="五子棋" FontSize="15" FontWeight="Bold" Foreground="#e6ecf5"/>
                                        <TextBlock Text="连五子 · 快节奏" FontSize="11" Foreground="#8b98b5"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding RoomNameInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" ToolTip="房间名（可选）"/>
                            <TextBox Grid.Column="2" Text="{Binding RoomPasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" ToolTip="房间密码（可选）"/>
                            <CheckBox Grid.Column="4" Content="私密" IsChecked="{Binding RoomPrivateInput}"
                                       Foreground="#8b98b5" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="创建房间" Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding CreateRoomCmd}"/>
                            <Button Grid.Column="2" Content="快速加入" Style="{StaticResource Btn}"
                                    Command="{Binding QuickJoinCmd}"/>
                            <Button Grid.Column="4" Content="{Binding MatchButtonText}" Style="{StaticResource Btn}"
                                    Command="{Binding MatchCmd}" ToolTip="按积分自动匹配对手，再次点击取消"/>
                        </Grid>
                            <TextBlock Text="{Binding MatchHintText}" Foreground="#ffb74d" FontSize="12" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Matching, Converter={StaticResource BoolToVisConverter}}"/>
                            <Button Content="🤖 人机对战（和电脑下棋）" Style="{StaticResource Btn}" Margin="0,8,0,0"
                                    Command="{Binding OpenAiPanelCmd}"/>
                            <!-- 选择电脑难度：点击人机对战后展开 -->
                            <Border Margin="0,8,0,0" Padding="12" CornerRadius="8"
                                    Background="#161e30" BorderBrush="#2a3550" BorderThickness="1"
                                    Visibility="{Binding AiPanelOpen, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="选择电脑难度" FontSize="13" FontWeight="Bold" Foreground="#e6ecf5" Margin="0,0,0,8"/>
                                    <ComboBox Style="{StaticResource Combo}" Width="160" HorizontalAlignment="Left"
                                              ItemsSource="{Binding AiLevelOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedAiLevel}"
                                              ToolTip="选择电脑棋力强度"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="开始对战" Style="{StaticResource PrimaryBtn}"
                                                Command="{Binding StartAiCmd}"/>
                                        <Button Content="取消" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                                Command="{Binding CloseAiPanelCmd}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#1b2438" Padding="12" CornerRadius="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="房间列表" FontWeight="Bold" Foreground="#e6ecf5" Margin="0,0,0,8"/>
                        <ListView x:Name="RoomListView" ItemsSource="{Binding RoomList}" Background="Transparent"
                                  BorderThickness="0" MouseDoubleClick="RoomList_DoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#202a44" CornerRadius="6" Padding="10,6" Margin="0,2">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" Foreground="#8b98b5" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Lock}" Foreground="#ffd54a" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding GameName}" Foreground="#4f8cff" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="#ffb74d" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#e6ecf5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 右：好友 + 标签页（排行榜/战绩/聊天） -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 好友面板 -->
                <Border Grid.Row="0" Background="#1b2438" Padding="12" CornerRadius="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Border DockPanel.Dock="Right" Background="#ff4d4f" CornerRadius="9" MinWidth="18" Height="18" Margin="6,0,0,0"
                                    Visibility="{Binding HasUnreadPrivate, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding UnreadPrivateCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="👥 好友" FontWeight="Bold" Foreground="#e6ecf5" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FriendAddInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" ToolTip="输入好友昵称"/>
                            <Button Grid.Column="2" Content="添加" Style="{StaticResource PrimaryBtn}" Command="{Binding AddFriendCmd}"/>
                        </Grid>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding FriendRequests}" Margin="0,0,0,6"
                                      Visibility="{Binding HasFriendRequests, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2a2333" CornerRadius="6" Padding="8,6" Margin="0,2">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="接受" Style="{StaticResource SmallBtn}" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.AcceptFriendCmd, ElementName=Root}"
                                                    CommandParameter="{Binding}"/>
                                            <Button DockPanel.Dock="Right" Content="拒绝" Style="{StaticResource SmallBtn}" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RejectFriendCmd, ElementName=Root}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Name}" Foreground="#ffd54a" VerticalAlignment="Center"/>
                                            <TextBlock Text=" 请求加好友" Foreground="#8b98b5" FontSize="11" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid>
                            <ListView ItemsSource="{Binding Friends}" Background="Transparent" BorderThickness="0">
                                <ListView.Style>
                                    <Style TargetType="ListView">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInPrivateChat}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <EventSetter Event="MouseDoubleClick" Handler="FriendItem_DoubleClick"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#202a44" CornerRadius="6" Padding="8,5" Margin="0,2"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="私聊" Click="FriendMenu_PrivateChat"/>
                                                    <MenuItem Header="删除好友" Click="FriendMenu_Remove"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="#8b98b5" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="#e8ecf4" BorderBrush="#c0c8d8" BorderThickness="1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Avatar}" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Foreground="#e6ecf5" VerticalAlignment="Center"/>
                                                <!-- 未读消息红点 -->
                                                <Border Background="#ff4d4f" CornerRadius="8" MinWidth="16" Height="16" Margin="6,0,0,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 私聊面板（覆盖在好友列表之上） -->
                            <Border Background="#141a28"
                                    Visibility="{Binding IsInPrivateChat, Converter={StaticResource BoolToVisConverter}}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="返回" Style="{StaticResource SmallBtn}"
                                                Command="{Binding ClosePrivateChatCmd}"/>
                                        <TextBlock Text="{Binding SelectedFriendChat.Name, StringFormat='与 {0} 私聊'}" FontWeight="Bold" Foreground="#e6ecf5" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource PrimaryBtn}" Width="64" Margin="8,0,0,0"
                                                Command="{Binding SendPrivateChatCmd}"/>
                                        <ctl:EmojiPicker DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                                         EmojiPicked="PrivateEmoji_Picked"/>
                                        <TextBox Text="{Binding PrivateInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ChatInputBox}" KeyDown="PrivateChat_KeyDown"/>
                                    </DockPanel>
                                    <ListBox x:Name="PrivateChatList" ItemsSource="{Binding CurrentPrivateMessages}" Background="Transparent"
                                             BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ItemTemplate="{StaticResource ChatBubbleTemplate}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="VerticalContentAlignment" Value="Top"/>
                                                <Setter Property="Padding" Value="0"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 标签页：排行榜 / 我的战绩 / 大厅聊天 -->
                <Border Grid.Row="2" Background="#1b2438" Padding="12" CornerRadius="8">
                    <DockPanel>
                        <!-- 标签切换按钮 -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="🏆 排行榜" IsChecked="{Binding SelectedRightTab, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                         Style="{StaticResource TabRadioStyle}" Margin="0,0,8,0"/>
                            <RadioButton Content="📜 战绩" IsChecked="{Binding SelectedRightTab, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                         Style="{StaticResource TabRadioStyle}" Margin="0,0,8,0"/>
                            <RadioButton Content="💬 聊天" IsChecked="{Binding SelectedRightTab, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"
                                         Style="{StaticResource TabRadioStyle}"/>
                        </StackPanel>

                        <!-- 标签内容 -->
                        <Grid>
                            <!-- 排行榜 -->
                            <DockPanel Visibility="{Binding SelectedRightTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=0}">
                                <ListView ItemsSource="{Binding Rankings}" Background="Transparent" BorderThickness="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Rating}" Foreground="#ffd54a" FontWeight="Bold"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Record}" Foreground="#8b98b5" FontSize="11" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Medal}" Width="26"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#e6ecf5" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </DockPanel>

                            <!-- 我的战绩 -->
                            <DockPanel Visibility="{Binding SelectedRightTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=1}">
                                <ListBox x:Name="MyMatchList" ItemsSource="{Binding MyMatches}" Background="Transparent"
                                         BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Display}" Foreground="#c8d3e8" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="复盘" Style="{StaticResource SmallBtn}" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.ReplayMatchCmd, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- 大厅聊天 -->
                            <Grid Visibility="{Binding SelectedRightTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=2}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox Grid.Row="0" x:Name="LobbyChatList" ItemsSource="{Binding LobbyChats}" Background="Transparent"
                                         BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                         ItemTemplate="{StaticResource ChatBubbleTemplate}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <DockPanel Grid.Row="1">
                                    <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource PrimaryBtn}" Width="64"
                                            Margin="8,0,0,0" Command="{Binding SendLobbyChatCmd}"/>
                                    <ctl:EmojiPicker DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     EmojiPicked="LobbyEmoji_Picked"/>
                                    <TextBox Text="{Binding LobbyChatInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ChatInputBox}" KeyDown="LobbyChat_KeyDown"/>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        </DockPanel>

        <!-- 头像选择面板（覆盖层，点击遮罩关闭） -->
        <Grid Background="#80000000" Visibility="{Binding AvatarPanelOpen, Converter={StaticResource BoolToVisConverter}}"
              MouseDown="AvatarOverlay_MouseDown">
            <Border Background="#ffffff" BorderBrush="#d0d8e8" BorderThickness="1" CornerRadius="12"
                    Padding="16" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="AvatarPanel_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="选择头像" FontSize="16" FontWeight="Bold" Foreground="#333333"/>
                        <Button DockPanel.Dock="Right" Content="✕" Click="CloseAvatar_Click"
                                Background="Transparent" BorderThickness="0" Foreground="#666666"
                                FontSize="16" Cursor="Hand" Padding="4,0"/>
                    </DockPanel>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvatarOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectAvatarCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
                                        <Border Width="48" Height="48" CornerRadius="8" Background="#f0f2f5">
                                            <TextBlock Text="{Binding}" FontSize="28"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 复盘面板（覆盖层） -->
        <Grid Background="#80000000" Visibility="{Binding ReplayPanelOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#1b2438" BorderBrush="#3a4a78" BorderThickness="1" CornerRadius="12"
                    Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="800">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 标题栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="棋谱复盘" FontSize="16" FontWeight="Bold" Foreground="#e6ecf5"
                                   HorizontalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding CloseReplayCmd}"
                                Background="Transparent" BorderThickness="0" Foreground="#8b98b5"
                                FontSize="16" Cursor="Hand" Padding="8,4" HorizontalAlignment="Right"/>
                    </Grid>
                    <!-- 棋盘和棋谱 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <!-- 棋盘 -->
                        <Border Grid.Column="0" Background="#e8c97e" CornerRadius="8" Padding="4">
                            <ctl:XiangqiBoard Game="{Binding ReplayGame}" IsHitTestVisible="False"/>
                        </Border>
                        <!-- 棋谱列表 -->
                        <Border Grid.Column="2" Background="#141a28" CornerRadius="8" Padding="8" MinHeight="200">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="棋谱" FontWeight="Bold" Foreground="#e6ecf5" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding ReplayGame.Moves}" Background="Transparent" BorderThickness="0"
                                         SelectedIndex="{Binding ReplayIndex, Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         MaxHeight="400">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Notation}" Foreground="#c8d3e8" FontSize="12" Padding="4,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <!-- 控制按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="⏮ 首步" Style="{StaticResource SmallBtn}" Command="{Binding ReplayFirstCmd}" Margin="0,0,8,0"/>
                        <Button Content="◀ 上一步" Style="{StaticResource SmallBtn}" Command="{Binding ReplayPrevCmd}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ReplayStatusText}" Foreground="#e6ecf5" VerticalAlignment="Center" Margin="8,0" MinWidth="80" TextAlignment="Center"/>
                        <Button Content="下一步 ▶" Style="{StaticResource SmallBtn}" Command="{Binding ReplayNextCmd}" Margin="8,0,8,0"/>
                        <Button Content="末步 ⏭" Style="{StaticResource SmallBtn}" Command="{Binding ReplayLastCmd}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
