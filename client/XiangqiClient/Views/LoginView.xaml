<UserControl x:Class="XiangqiClient.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#141a28">
        <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#1b2438" CornerRadius="14" Padding="30,26"
                BorderBrush="#2a3550" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="⚔️ 对战平台" FontSize="24" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="联网对战 · 中国象棋 / 五子棋" Foreground="#8b98b5" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- 模式切换 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="登 录" Click="TabLogin_Click"
                            AutomationProperties.Name="切换登录">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#2a3550"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoginMode}" Value="True">
                                        <Setter Property="Background" Value="#4f8cff"/>
                                        <Setter Property="BorderBrush" Value="#4f8cff"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="注 册" Click="TabRegister_Click"
                            AutomationProperties.Name="切换注册">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#2a3550"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegisterMode}" Value="True">
                                        <Setter Property="Background" Value="#4f8cff"/>
                                        <Setter Property="BorderBrush" Value="#4f8cff"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- ======== 登录表单 ======== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoginMode}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="服务器地址" Foreground="#8b98b5" FontSize="12" Margin="4,0,0,4"/>
                    <TextBox x:Name="ServerBox" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="昵称（点击右侧箭头可选历史账号）" Foreground="#8b98b5" FontSize="12" Margin="4,0,0,4"/>
                    <ComboBox x:Name="NameBox" IsEditable="True" StaysOpenOnEdit="True"
                              Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding AccountHistory}"
                              SelectionChanged="NameBox_SelectionChanged"
                              Style="{StaticResource InputCombo}" Margin="0,0,0,12"/>

                    <TextBlock Text="密码" Foreground="#8b98b5" FontSize="12" Margin="4,0,0,4"/>
                    <PasswordBox x:Name="PassBox" PasswordChanged="PassBox_PasswordChanged"
                                 Style="{StaticResource InputBoxPass}" Margin="0,0,0,8"/>

                    <DockPanel Margin="2,0,0,14">
                        <CheckBox IsChecked="{Binding RememberAccount}" Foreground="#8b98b5" FontSize="12"
                                  VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="记住账号（自动填充昵称与密码）" Foreground="#8b98b5" FontSize="12"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding RememberHint}" Foreground="#5c6b8f"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="登 录" Style="{StaticResource PrimaryBtn}"
                                Click="Login_Click" IsDefault="True" AutomationProperties.Name="提交登录"/>
                        <Button Grid.Column="2" Content="游客体验" Style="{StaticResource Btn}"
                                Click="Guest_Click"/>
                    </Grid>
                </StackPanel>

                <!-- ======== 注册表单 ======== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RegisterMode}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="服务器地址" Foreground="#8b98b5" FontSize="12" Margin="4,0,0,4"/>
                    <TextBox x:Name="RegServerBox" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="昵称" Foreground="#8b98b5" FontSize="12" Margin="4,0,0,4"/>
                    <TextBox x:Name="RegNameBox" Text="{Binding RegisterName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}"/>
                    <TextBlock Text="2-16 位中文 / 字母 / 数字 / 下划线 / 连字符" Foreground="#5c6b8f"
                               FontSize="11" Margin="4,3,0,10"/>

                    <TextBlock Text="密码" Foreground="#8b98b5" FontSize="12" Margin="4,0,0,4"/>
                    <PasswordBox x:Name="RegPassBox" PasswordChanged="RegPassBox_PasswordChanged"
                                 Style="{StaticResource InputBoxPass}"/>
                    <TextBlock Text="4-64 位，建议包含字母与数字" Foreground="#5c6b8f"
                               FontSize="11" Margin="4,3,0,10"/>

                    <TextBlock Text="确认密码" Foreground="#8b98b5" FontSize="12" Margin="4,0,0,4"/>
                    <PasswordBox x:Name="RegConfirmBox" PasswordChanged="RegConfirmBox_PasswordChanged"
                                 Style="{StaticResource InputBoxPass}" Margin="0,0,0,16"/>

                    <Button Content="注 册" Style="{StaticResource PrimaryBtn}"
                            Click="Register_Click" IsEnabled="{Binding CanRegister}"
                            AutomationProperties.Name="提交注册"/>
                    <Button Content="填入测试账号" Style="{StaticResource SmallBtn}"
                            Click="TestFill_Click" Margin="0,8,0,0"
                            Visibility="{Binding ShowTestFill, Converter={StaticResource BoolToVisConverter}}"/>
                    <TextBlock Text="已有账号？返回登录" Foreground="#4f8cff" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding Path=DataContext.SwitchModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="False"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>

                <!-- 表单校验错误 -->
                <TextBlock Text="{Binding FormError}" Foreground="#ff5d5d" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFormError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 状态提示 -->
                <TextBlock Text="{Binding StatusText}" Foreground="#ffd54a" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
