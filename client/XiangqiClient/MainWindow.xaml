<Window x:Class="XiangqiClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:XiangqiClient.Views"
        Title="对战平台 · 中国象棋 / 五子棋" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#141a28"
        Icon="pack://application:,,,/Assets/chessIcon.ico">

    <Grid>
        <views:LoginView x:Name="LoginViewControl">
            <views:LoginView.Style>
                <Style TargetType="views:LoginView">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLogin}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LoginView.Style>
        </views:LoginView>

        <views:LobbyView>
            <views:LobbyView.Style>
                <Style TargetType="views:LobbyView">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLobby}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LobbyView.Style>
        </views:LobbyView>

        <views:RoomView>
            <views:RoomView.Style>
                <Style TargetType="views:RoomView">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRoom}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:RoomView.Style>
        </views:RoomView>
    </Grid>
</Window>
